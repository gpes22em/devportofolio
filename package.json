  background: #0B0F19;
  border: 1px solid #2D3748;
  border-radius: 0.25rem;
  padding: 12px 16px;
  color: white;
  width: 100%;
  outline: none;
  transition: all 0.2s;
  }
  .input-base:focus {
  border-color: #FF5A27;
  box-shadow: 0 0 0 2px rgba(255, 90, 39, 0.3);
  }
  .btn-primary {
  background: #FF5A27;
  color: white;
  padding: 12px 24px;
  border-radius: 0.25rem;
  font-weight: 700;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  }
  .btn-primary:hover {
  opacity: 0.9;
  transform: translateY(-1px);
  }
  .btn-primary:active {
  transform: translateY(0);
  }
  .btn-secondary {
  background: transparent;
  border: 1px solid white;
  color: white;
  padding: 12px 24px;
  border-radius: 0.25rem;
  font-weight: 600;
  transition: all 0.2s;
  }
  .btn-secondary:hover {
  background: white;
  color: #0B0F19;
  }
  .nav-btn {
  background: #1E293B;
  border: 1px solid #2D3748;
  color: #94A3B8;
  padding: 8px 16px;
  border-radius: 0.25rem;
  font-weight: 600;
  font-size: 14px;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  }
  .nav-btn:hover {
  border-color: #FF5A27;
  color: white;
  background: rgba(255, 90, 39, 0.1);
  transform: translateY(-1px);
  }
  .nav-btn.active {
  background: #FF5A27;
  border-color: #FF5A27;
  color: white;
  }
  .reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .reveal.active {
  opacity: 1;
  transform: translateY(0);
  }
  .chip {
  background: rgba(255, 90, 39, 0.1);
  color: #FF5A27;
  padding: 4px 12px;
  border-radius: 0.25rem;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  }
  .alert-box {
    display: none;
    padding: 12px 16px;
    border-radius: 0.5rem;
    margin-bottom: 16px;
    font-size: 14px;
  }
  .alert-box.success { background: #064e3b; color: #6ee7b7; border: 1px solid #059669; display: block; }
  .alert-box.error { background: #450a0a; color: #fca5a5; border: 1px solid #dc2626; display: block; }
  .alert-box.info { background: #1e3a8a; color: #93c5fd; border: 1px solid #3b82f6; display: block; }
