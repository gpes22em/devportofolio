<script>
const menuBtn = document.getElementById('menuBtn');
const mobileMenu = document.getElementById('mobileMenu');
menuBtn?.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));

// Navigation buttons functionality
const navButtons = document.querySelectorAll('[data-nav]');
const sections = ['hero', 'portfolio', 'services', 'contact'];

navButtons.forEach(btn => {
  btn.addEventListener('click', (e) => {
    e.preventDefault();
    const target = btn.getAttribute('href');
    document.querySelector(target)?.scrollIntoView({ behavior: 'smooth' });
    mobileMenu.classList.add('hidden');

    // Update active state
    navButtons.forEach(b => b.classList.remove('active'));
    document.querySelectorAll(`[data-nav="${btn.dataset.nav}"]`).forEach(b => b.classList.add('active'));
  });
});

// Auto-update active nav on scroll - using Intersection Observer for accuracy
function updateActiveNav() {
  let current = 'hero';
  sections.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      const rect = el.getBoundingClientRect();
      if (rect.top <= 150) current = id;
    }
  });
  navButtons.forEach(b => {
    b.classList.toggle('active', b.dataset.nav === current);
  });
}
window.addEventListener('scroll', updateActiveNav);
// Initial call
updateActiveNav();

function reveal() {
  document.querySelectorAll(".reveal").forEach(el => {
    if (el.getBoundingClientRect().top < window.innerHeight - 100) {
      el.classList.add("active");
    }
  });
}
window.addEventListener("scroll", reveal);
reveal();

// Form Submission with JSON (Vercel Serverless API)
const projectForm = document.getElementById('projectForm');
const submitBtn = document.getElementById('submitBtn');
const alertBox = document.getElementById('alertBox');

projectForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  alertBox.className = 'alert-box';
  alertBox.textContent = '';

  // Check reCAPTCHA
  const recaptchaResponse = grecaptcha.getResponse();
  if (!recaptchaResponse) {
    alertBox.className = 'alert-box error';
    alertBox.textContent = '❌ Harap centang "I\'m not a robot" terlebih dahulu.';
    return;
  }

  submitBtn.disabled = true;
  const originalBtnText = submitBtn.innerHTML;
  submitBtn.innerHTML = `<span class="material-symbols-outlined animate-spin">sync</span> Memproses...`;

  // Collect form data as JSON (Vercel API accepts JSON)
  const formData = new FormData(projectForm);
  const data = Object.fromEntries(formData.entries());
  data['g-recaptcha-response'] = recaptchaResponse;

  try {
    const res = await fetch('/api/order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    const result = await res.json();

    if (res.ok && result.status === 'success') {
      alertBox.className = 'alert-box success';
      alertBox.textContent = '✅ ' + (result.message || 'Pengajuan berhasil! Kami akan segera menghubungi Anda.');
      projectForm.reset();
      grecaptcha.reset();
    } else {
      throw new Error(result.message || 'Terjadi kesalahan pada server.');
    }
  } catch (err) {
    alertBox.className = 'alert-box error';
    alertBox.textContent = '❌ ' + err.message;
    grecaptcha.reset();
  } finally {
    submitBtn.disabled = false;
    submitBtn.innerHTML = originalBtnText;
  }
});

document.getElementById('downloadBtn')?.addEventListener('click', () => {
  alert('Demo APK akan segera tersedia. Hubungi kami via WhatsApp untuk akses early preview.');
});
document.getElementById('demoBtn')?.addEventListener('click', () => {
  document.getElementById('portfolio').scrollIntoView({behavior: 'smooth'});
});
</script>
</body>
</html>
